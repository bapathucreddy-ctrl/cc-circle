EXPO_PUBLIC_SUPABASE_ONLINE=true
# Online Supabase configuration (used when ONLINE=true).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local Supabase configuration (used when ONLINE=false).
# Android emulator address; use your computer's LAN IP for a physical phone.
EXPO_PUBLIC_LOCAL_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_LOCAL_SUPABASE_KEY=
# Map display, 3D tracking and directions remain Mapbox.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
IOS_BUNDLE_IDENTIFIER=com.cccircle.development
ANDROID_PACKAGE=com.cccircle.development

# Optional Expo project links for native development builds (IDs are not secrets).
EAS_CUSTOMER_PROJECT_ID=dc25f7c7-f25a-4226-bb8e-9756f6c888c7
EAS_PROFESSIONAL_PROJECT_ID=7090c00b-4bb8-4cb1-831c-9ecd19772f50
# Public Firebase Android app config file for the selected variant (not the private service account).
# customer package: com.cccircle.customer; professional: com.cccircle.professional.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_CUSTOMER_JSON=
GOOGLE_SERVICES_PROFESSIONAL_JSON=
# Enable only in Apple-signed builds after APNs server credentials are configured.
IOS_PUSH_ENABLED=false
