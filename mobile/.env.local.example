# Local development only. Copy to .env.local after starting local Supabase.
EXPO_PUBLIC_SUPABASE_ONLINE=false
# Android emulator: http://10.0.2.2:54321
# Physical phone: use your development computer's private LAN IP on the same network.
EXPO_PUBLIC_LOCAL_SUPABASE_URL=http://10.0.2.2:54321
# Use the LOCAL publishable/anon key, never the local secret/service-role key.
EXPO_PUBLIC_LOCAL_SUPABASE_KEY=
