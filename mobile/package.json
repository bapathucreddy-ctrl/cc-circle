{
  "name": "cc-circle-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/app.cjs customer start --dev-client",
    "web": "node scripts/app.cjs customer start --web --host lan --port 8081",
    "start:customer": "node scripts/app.cjs customer start --dev-client --port 8081",
    "start:professional": "node scripts/app.cjs professional start --dev-client --port 8082",
    "web:customer": "node scripts/app.cjs customer start --web --host lan --port 8081",
    "web:professional": "node scripts/app.cjs professional start --web --host lan --port 8082",
    "export:customer": "node scripts/app.cjs customer export --platform all --output-dir .local-build/customer-export",
    "export:professional": "node scripts/app.cjs professional export --platform all --output-dir .local-build/professional-export",
    "android": "node scripts/app.cjs customer run:android",
    "ios": "node scripts/app.cjs customer run:ios",
    "android:customer": "node scripts/app.cjs customer run:android",
    "android:professional": "node scripts/app.cjs professional run:android",
    "ios:customer": "node scripts/app.cjs customer run:ios",
    "ios:professional": "node scripts/app.cjs professional run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@rnmapbox/maps": "10.3.7",
    "@supabase/supabase-js": "2.117.2",
    "base64-js": "1.5.1",
    "cashfree-pg-api-contract": "2.1.0",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "mapbox-gl": "^3.32.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-cashfree-pg-sdk": "2.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "@rnmapbox/maps": {
      "mapbox-gl": "$mapbox-gl"
    }
  }
}
