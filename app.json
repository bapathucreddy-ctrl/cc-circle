{
  "expo": {
    "name": "CC Circle",
    "slug": "cc-circle",
    "version": "1.0.0",
    "scheme": "cccircle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for your CC Circle profile.",
          "cameraPermission": "Take a live photo for a consented profile review.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cccreativelabs.cccircle",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture a live photo for a consented profile review."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#241936",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cccreativelabs.cccircle",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
