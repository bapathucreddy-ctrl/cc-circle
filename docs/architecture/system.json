  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Client bundles contain public configuration only; provider secrets stay in Edge Functions or encrypted Vault.",
        "RLS and validated RPCs protect participant data, admin access and authoritative state changes."
      ]
    },
    {
      "dot": "cyan",
      "title": "Client data freshness",
      "items": [
        "Resource caches are scoped to the signed-in user; foreground polling revalidates state.",
        "Realtime subscriptions complement polling for booking/chat/notification changes."
      ]
    },
    {
      "dot": "slate",
      "title": "Reading this map",
      "items": [
        "Apps are grouped because Customer and Professional share one source tree but have distinct native identities.",
        "Marketing hosting is independent of authenticated app operations. Source snapshot includes current local edits."
      ]
    }
  ]
