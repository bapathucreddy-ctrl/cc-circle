  "cards": [
    {
      "dot": "amber",
      "title": "Timing and funds",
      "items": [
        "Eligibility is 24 hours after BOTH completion and verified payment; bank receipt is not guaranteed at that exact time.",
        "The deployed Cashfree environment remains sandbox. PG settlement and Payouts funding are separate."
      ]
    },
    {
      "dot": "rose",
      "title": "Bank changes and retries",
      "items": [
        "Raw bank details go to Cashfree; app tables keep the beneficiary ID, account ending and IFSC.",
        "A destination is frozen before transfer submission. Later bank edits cannot redirect that transfer.",
        "The same transfer ID is reconciled on retries; mismatched amounts, environment or beneficiary stop submission."
      ]
    },
    {
      "dot": "cyan",
      "title": "Billing branches",
      "items": [
        "Per-session services normally require verified payment before travel.",
        "Legacy hourly wedding invoices are finalized from OTP times and paid after service.",
        "Eligible cancellations queue refunds; refunds and payout workers have separate responsibilities."
      ]
    }
  ]
