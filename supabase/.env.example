# Server secrets: configure using Supabase secrets, never EXPO_PUBLIC_* variables.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WORKER_SECRET=
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# Portfolio import credentials: server-only, separate from Supabase Google sign-in.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Android push worker: service-account JSON on a single line, server only.
FCM_SERVICE_ACCOUNT_JSON=
# iOS APNs signing credentials, server only. Private key is Apple .p8 contents.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
# Random private worker secret; also stored in Supabase Vault for the scheduler.
NOTIFICATION_DISPATCH_SECRET=
INSTAGRAM_API_VERSION=v25.0
# Base64-encoded 32 random bytes; keep stable once connections are stored.
PORTFOLIO_TOKEN_KEY=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the deployed runtime.
# Place search and coordinates only: restrict this server-only key to Places API (New).
GOOGLE_MAPS_SERVER_KEY=
# Exact browser origins, comma-separated. Native APK requests need no Origin header.
# Add the actual hosted web origins and any LAN development URLs you use.
ALLOWED_WEB_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://0.0.0.0:8081,http://0.0.0.0:8082

# Server-only key restricted to Cloud Vision API for portfolio image review.
GOOGLE_CLOUD_VISION_API_KEY=
